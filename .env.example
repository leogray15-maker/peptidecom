# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Vercel Postgres, Neon, Supabase, Railway, etc.)
# If this points at a pooler, the app adds connection_limit=1 (and pgbouncer=true
# on Supabase's transaction port 6543) so a few warm lambdas can't empty the
# pool between them. Set either param here yourself to override it.
DATABASE_URL="postgresql://user:password@localhost:5432/peptidecom?schema=public"
# Optional, and worth setting whenever DATABASE_URL goes through a connection
# pooler (Supabase's *.pooler.supabase.com, PgBouncer). The build's schema push
# needs a session of its own; through a pooler it competes for a small fixed
# number of them and fails with "max clients reached in session mode". Point
# this at the same database's non-pooled connection string.
# DIRECT_URL="postgresql://user:password@db.example.supabase.co:5432/postgres"

# ─── Firebase (Authentication + Firestore chat) ──────────────────────────────
# Client config — from Firebase console → Project settings → Your apps (Web app).
# These are public (safe to expose in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# Admin SDK (server) — from a service account JSON key (Project settings →
# Service accounts → Generate new private key). Keep these SECRET.
#
# EASIEST: paste the ENTIRE service-account JSON into a single variable:
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
#
# OR provide the three fields separately (leave FIREBASE_SERVICE_ACCOUNT unset):
# FIREBASE_PROJECT_ID="your-project"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` locally, or the dashboard webhook endpoint in prod
STRIPE_WEBHOOK_SECRET="whsec_..."
# Subscription price IDs (create these recurring GBP prices in the Stripe dashboard):
#   Founding = £45/month (first 50 members lock this in for life)
#   Standard = £55/month (everyone after the founding offer closes)
STRIPE_PRICE_FOUNDING="price_..."
STRIPE_PRICE_STANDARD="price_..."
# One-time coupon that brings a founding member's FIRST month down to £28.
# Create a coupon in Stripe: Amount off = £17.00 GBP, Duration = Once. Paste its ID here.
STRIPE_COUPON_FOUNDING_FIRST_MONTH="promo_or_coupon_id"

# ─── Founding offer ──────────────────────────────────────────────────────────
# How many founding spots, and when the offer closes (whichever comes first).
FOUNDING_LIMIT="50"
NEXT_PUBLIC_FOUNDING_DEADLINE="2026-08-03T23:59:59Z"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Arcane Track"
# Comma-separated emails that are always ADMIN with full access (bypass paywall).
ADMIN_EMAILS="leogray15@gmail.com"
# Set this to enable a reliable admin login (email in ADMIN_EMAILS + this password)
# that works without Firebase/Google. Pick any strong password.
ADMIN_LOGIN_PASSWORD="choose-a-strong-password"

# Where the Protocols tab points (e.g. a public Notion page with your mini
# courses). Leave unset to show a "coming soon" state.
# NEXT_PUBLIC_PROTOCOLS_URL="https://www.notion.so/your-protocols-page"

# WhatsApp community invite link for the chat tab. Leave unset to show a
# "being set up" state.
# NEXT_PUBLIC_WHATSAPP_INVITE_URL="https://chat.whatsapp.com/XXXXXXXXXXX"

# ─── The Arcane Archives (sister product funnel) ─────────────────────────────
# Where the "Step into The Archives" CTA points. Leave unset to show a soft
# "doors open soon" state instead of a link.
# NEXT_PUBLIC_ARCHIVES_URL="https://thearcanearchives.com"

# ─── Cloudflare Turnstile (bot protection) ──────────────────────────────────
# Optional. With both unset the widget never renders and verification is a
# no-op, so signup and community posting behave exactly as before. Set both to
# switch it on for signup (new accounts only) and the community post form.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# Shared secret proving a request arrived via the edge gate Worker
# (workers/ai-grade-gate). Only meaningful once that Worker is deployed —
# see docs/cloudflare-scope.md.
# ARCANE_GATE_SECRET="choose-a-long-random-string"
